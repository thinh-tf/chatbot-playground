{
  "name": "chatbot-playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "agent": "langgraphjs dev --port 2024 --no-browser",
    "eval": ".venv/bin/deepeval test run tests/evals/test_support_agent.py --identifier prompt-${AGENT_PROMPT_VERSION:-v2}",
    "eval:summary": ".venv/bin/python tests/evals/summarize.py --reasons",
    "eval:setup": "uv venv .venv --python 3.12 && uv pip install --python .venv/bin/python -r tests/evals/requirements.txt",
    "eval:push-dataset": ".venv/bin/python tests/evals/push_dataset.py"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.28",
    "@assistant-ui/react-langchain": "^0.0.36",
    "@assistant-ui/react-markdown": "^0.14.21",
    "@base-ui/react": "^1.8.0",
    "@langchain/core": "^1.2.17",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-sdk": "^1.12.3",
    "@langchain/react": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.13",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@assistant-ui/next": "latest",
    "@langchain/langgraph-cli": "^1.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
